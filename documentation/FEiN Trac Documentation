{{{#!sql
CREATE OR REPLACE FUNCTION set_transaction_date()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    IF NEW.date IS NULL THEN
        NEW.date := NOW();
    END IF;

    RETURN NEW;
END;
$$;


CREATE TRIGGER trg_set_transaction_date
BEFORE INSERT
ON transaction
FOR EACH ROW
EXECUTE FUNCTION set_transaction_date();
