    SELECT
        SUM(daily_spending) / p_days AS average_spending
    FROM (
        -- генерација на последни p_days
        SELECT
            d.day::date AS transaction_date,
            COALESCE(SUM(tb.spent_amount), 0) AS daily_spending
        FROM (
